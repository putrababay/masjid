{
  "name": "masjid-tv",
  "private": true,
  "version": "1.0.0",
  "description": "Smart TV Masjid — Cloudflare Pages + D1",
  "scripts": {
    "dev": "wrangler pages dev . --local --persist-to .wrangler/state --port 8788",
    "db:schema:local": "wrangler d1 execute masjid-db --local --file=./schema-d1.sql",
    "db:seed:local": "wrangler d1 execute masjid-db --local --file=./seed-d1.sql",
    "db:reset:local": "npm run db:schema:local && npm run db:seed:local",
    "db:schema:remote": "wrangler d1 execute masjid-db --remote --file=./schema-d1.sql",
    "db:seed:remote": "wrangler d1 execute masjid-db --remote --file=./seed-d1.sql",
    "deploy": "wrangler pages deploy . --project-name=masjid-tv"
  },
  "devDependencies": {
    "wrangler": "^4.114.0"
  }
}
